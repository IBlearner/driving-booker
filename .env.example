# Instructor / business contact details shown across the site
VITE_INSTRUCTOR_NAME="Duc Tinh Lam"
VITE_CONTACT_PHONE="+61 400 123 456"
VITE_CONTACT_EMAIL="hello@lamdriving.example"
VITE_SERVICE_AREA="Brisbane, QLD"

# Headline numbers shown on the home and information pages.
VITE_YEARS_EXPERIENCE="12"
VITE_STUDENTS_PASSED="1200"
VITE_PASS_RATE="95"

# EmailJS configuration for booking form submissions.
# Sign up at https://www.emailjs.com/ and create a service + template.
# The template can use these variables: to_name, from_name, reply_to, phone,
# lesson, experience, has_car, preferred_date, preferred_time, notes, language.
#
# If these are left blank, `npm run dev` shows a local confirmation (no email is
# sent) so the app still runs for review. A production build with these blank
# shows an error on the booking form instead, so requests are never lost silently.
VITE_EMAILJS_SERVICE_ID=""
VITE_EMAILJS_TEMPLATE_ID=""
VITE_EMAILJS_PUBLIC_KEY=""
